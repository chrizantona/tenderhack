# EasyTender environment variables.
# Copy to `.env` and edit. Docker compose picks .env up automatically;
# locally you can `set -a; source .env; set +a; python3 app/server.py`.

# === Ozon proxy pool (RU SOCKS5 / HTTP) ===
# Comma-separated host:port list. Aggregator routes Ozon AND WB+YM via the
# first item (or full pool for WB rotation). Defaults to proxy6.net pool
# hardcoded in app/aggregator.py — override only if you have your own.
# OZON_PROXIES=
# OZON_PROXY_USER=
# OZON_PROXY_PASS=
# OZON_PROXY_SCHEME=http       # or socks5
# OZON_PROXY_DISABLE=1         # set to skip proxy for Ozon entirely

# === Ozon enrichment ===
# How many products in the search result get a separate browser fetch for
# full characteristics. Default 10 (search-time enrich workers run 8-way
# parallel). 0 = base items only, enrich on modal click. Lower = faster
# initial response, less RAM.
# OZON_ENRICH_MAX=10

# === Yandex Market proxy ===
# If unset, YM uses the first OZON_PROXIES entry.
# YM_PROXY=http://user:pass@host:port
# YM_PROXY_DISABLE=1            # YM direct (only works inside RU)

# === Qwen LLM (other_runet only, Apple Silicon only) ===
# Optional — without these `other_runet` source works but skips AI-assisted
# extraction. Install `pip install mlx mlx-lm` and download model first.
# QWEN_MODEL_PATH=/Users/chrizantona/qwen/Qwen2.5-Coder-14B-Instruct-4bit
# QWEN_SERVER_LOG=qwen_server.log
